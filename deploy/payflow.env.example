# /root/payflow/payflow.env on the server (chmod 600). Never commit the real file.
SPRING_PROFILES_ACTIVE=prod
PORT=8187
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:postgresql://127.0.0.1:5432/payflow
DB_USER=payflow
DB_PASSWORD=<generated>
JWT_SECRET=<openssl rand -base64 48>
DEMO_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx384m
